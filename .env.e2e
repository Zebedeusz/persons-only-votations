# E2E Test Environment Configuration
# Copy this to .env.e2e.local and adjust for your local setup

# People chain connection
E2E_PEOPLE_CHAIN_ENDPOINT=ws://127.0.0.1:54261

# Application server
E2E_SERVER_BASE_URL=http://127.0.0.1:3000

# Test configuration
E2E_TEST_TIMEOUT_SECONDS=30
E2E_CHAIN_CONNECTION_RETRIES=5

# Application configuration for e2e tests
PEOPLE_CHAIN_HOST=127.0.0.1
PEOPLE_CHAIN_PORT=54261
PEOPLE_CHAIN_PROTOCOL=ws
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
LOG_LEVEL=debug