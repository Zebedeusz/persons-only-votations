# E2E Test Environment Configuration - Mock Mode
# This configuration runs tests against the server in mock mode

# Enable mock mode
MOCK_MODE=true

# People chain connection (not used in mock mode but required for config)
E2E_PEOPLE_CHAIN_ENDPOINT=ws://127.0.0.1:9944

# Application server
E2E_SERVER_BASE_URL=http://127.0.0.1:3000

# Test configuration
E2E_TEST_TIMEOUT_SECONDS=30
E2E_CHAIN_CONNECTION_RETRIES=1

# Application configuration for e2e tests in mock mode
PEOPLE_CHAIN_HOST=127.0.0.1
PEOPLE_CHAIN_PORT=9944
PEOPLE_CHAIN_PROTOCOL=ws
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
LOG_LEVEL=debug